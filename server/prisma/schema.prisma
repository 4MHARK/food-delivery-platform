// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  RIDER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_RESTAURANT_CONFIRMATION
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DeliveryStatus {
  ZILLA_ON_IT
  AT_KITCHEN
  BAGGED
  MOVING
  CLOSE_BY
  DELIVERED
  FAILED
}

enum RestaurantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutType {
  RESTAURANT
  RIDER
}

// Why a delivery ended in FAILED. Kept on the audit row so accountability can
// tell a rider-reported problem apart from a burned handoff code.
enum DeliveryFailureKind {
  REPORTED
  CODE_ATTEMPTS
  // Auto-failed by the stale-delivery sweeper: no status update for too long.
  STALE
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model Campus {
  id          Int          @id @default(autoincrement())
  name        String
  address     String?
  users       User[]
  restaurants Restaurant[]
  riders      Rider[]
  landmarks   CampusLandmark[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  emailDomain String?      @unique
  lat Float?
  lng Float?
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String? @unique
  phone     String?
  role      UserRole @default(CUSTOMER)
  restaurants Restaurant[]
  orders      Order[]
  rider       Rider?
  restaurantReviews RestaurantReview[]
  riderReviews      RiderReview[]
  favorites         CustomerFavorite[]
  pushSubscriptions PushSubscription[]
  pushTokens        PushToken[]
  deliveryLocations CustomerDeliveryLocation[]
  campusId          Int?
  campus            Campus?  @relation(fields: [campusId], references: [id])
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campusId])
}

model CustomerDeliveryLocation {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  address    String
  lat        Float
  lng        Float
  // Optional link for the future saved-locations UI; checkout can keep using
  // the plain address/coords path until that UI exists.
  landmarkId Int?
  landmark   CampusLandmark? @relation(fields: [landmarkId], references: [id], onDelete: SetNull)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([landmarkId])
}

model CampusLandmark {
  id             Int      @id @default(autoincrement())
  campusId       Int
  name           String
  category       String   @default("OTHER")
  aliases        String[] @default([])
  lat            Float?
  lng            Float?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  campus         Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  orders         Order[]
  savedLocations CustomerDeliveryLocation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([campusId, name])
  @@index([campusId, isActive, sortOrder])
}

model Rider {
  id            Int         @id @default(autoincrement())
  userId        Int         @unique
  vehicleType   String
  licensePlate  String?
  licenseNumber String?     @unique
  matricNumber  String?     @unique
  isAvailable   Boolean     @default(true)
  isVerified    Boolean     @default(false)
  isSuspended   Boolean     @default(false)
  // Shown to the rider and kept only while suspended; cleared on unsuspend.
  suspensionReason String?
  // Accountability counters. failureCount is the lifetime total; the automatic
  // review flag is driven by a rolling window (see services/accountability.js).
  failureCount      Int       @default(0)
  lastFailureAt     DateTime?
  flaggedForReview Boolean   @default(false)
  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?
  recipientCode String?
  // Payout-account review. accountNameMismatch is informational (the Paystack
  // account name shares no token with the rider's name); the review flag gates
  // automatic payouts whenever the destination account changes.
  accountNameMismatch       Boolean   @default(false)
  bankDetailsUpdatedAt      DateTime?
  bankDetailsReviewRequired Boolean   @default(false)
  payouts                   Payout[]
  photoUrl      String?
  campusId      Int
  campus        Campus      @relation(fields: [campusId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  deliveries    Delivery[]
  rejectedOrders RejectedOrder[]
  reviews        RiderReview[]
  failures       DeliveryFailure[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([campusId])
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  description String
  phone     String
  imageUrl  String
  address   String
  menuItems MenuItem[]
  orders    Order[]
  reviews   RestaurantReview[]
  favoritedBy CustomerFavorite[]
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  campusId  Int
  campus    Campus   @relation(fields: [campusId], references: [id])
  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?
  recipientCode String?
  lat  Float?
  lng  Float?
  approvalStatus RestaurantApprovalStatus @default(PENDING)
  // Manual "accepting orders" switch; schedule is applied on top of this.
  isOpen Boolean @default(true)
  hours RestaurantHours[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([campusId])
}

model RestaurantHours {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  // 0 = Sunday … 6 = Saturday, in the restaurant timezone.
  dayOfWeek    Int
  openTime     String?
  closeTime    String?
  isClosed     Boolean    @default(false)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
}

model CustomerFavorite {
  id           Int        @id @default(autoincrement())
  userId       Int
  restaurantId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
}

model MenuItem {
  id Int @id @default(autoincrement())
  name String
  description String
  price Decimal @db.Decimal(10,2)
  restaurantId Int 
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  category String
  isAvailable Boolean @default (true)
  // null = not stock-tracked (unlimited); 0 = sold out.
  stockQuantity Int?
  orderItems OrderItem[]
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Order {
  id              Int         @id @default(autoincrement())
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal           Decimal @default(0) @db.Decimal(10,2)
  deliveryFee           Decimal @default(0) @db.Decimal(10,2)
  serviceFee           Decimal @default(0) @db.Decimal(10,2)
  totalAmount           Decimal @default(0) @db.Decimal(10,2)
  paidAt DateTime?
  deliveryCode   String?
  // Lifetime wrong-code attempts across every delivery for this order. Stops
  // a rider cycling a delivery to reset the per-delivery counter.
  deliveryCodeAttempts Int @default(0)
  paymentReference String?
  idempotencyKey String?
  // True while this order holds inventory; set false when stock is released.
  stockReserved Boolean @default(false)
  payment Payment?
  delivery Delivery?
  deliveryAddress String
  // Optional campus landmark + the block/room/floor detail for that landmark.
  deliveryLandmarkId Int?
  deliveryDetail     String?
  customerId      Int
  restaurantId    Int
  deliveryLat Float?
deliveryLng Float?
  deliveryLandmark CampusLandmark? @relation(fields: [deliveryLandmarkId], references: [id], onDelete: SetNull)
  customer        User        @relation(fields: [customerId], references: [id])
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems      OrderItem[]
  rejectedBy      RejectedOrder[]
  payouts         Payout[]
  failures        DeliveryFailure[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([restaurantId])
  @@index([deliveryLandmarkId])
  @@unique([customerId, idempotencyKey])
}

model Delivery {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique
  riderId       Int
  status        DeliveryStatus @default(ZILLA_ON_IT)
  // Wrong handoff-code attempts for THIS rider assignment. A new delivery
  // starts at zero, so a reassignment never inherits the previous lock.
  codeAttempts  Int            @default(0)
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failureReason String?
  // Proximity evidence captured at the handoff states. closeByVerified and
  // deliveredVerified preserve per-event results; locationVerified is the
  // summary of the latest check.
  // CLOSE_BY audit. closeByAt is the server receipt time; closeByCapturedAt
  // is the client's GPS fix time.
  closeByLat               Float?
  closeByLng               Float?
  closeByAccuracy          Float?
  closeByCapturedAt        DateTime?
  closeByAt                DateTime?
  closeByVerified          Boolean?
  closeByDistanceMeters    Float?
  closeByUnverifiedReason  String?
  // DELIVERED audit. deliveredAt is the server completion time;
  // deliveredCapturedAt is the client's GPS fix time.
  deliveredLat             Float?
  deliveredLng             Float?
  deliveredAccuracy        Float?
  deliveredCapturedAt      DateTime?
  deliveredVerified        Boolean?
  deliveredDistanceMeters  Float?
  deliveredUnverifiedReason String?
  order         Order          @relation(fields: [orderId], references: [id])
  rider         Rider          @relation(fields: [riderId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([riderId])
}

model RejectedOrder {
  id        Int      @id @default(autoincrement())
  riderId   Int
  orderId   Int
  rider     Rider    @relation(fields: [riderId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([riderId, orderId])
}

// Permanent record of a failed delivery attempt. The Delivery row itself is
// deleted when the order goes back to the queue, so this is the history that
// survives reassignment and holds a rider accountable across orders.
model DeliveryFailure {
  id           Int                 @id @default(autoincrement())
  orderId      Int
  riderId      Int
  kind         DeliveryFailureKind
  reason       String?
  // Wrong-code attempts burned on the assignment that failed.
  codeAttempts Int                 @default(0)
  createdAt    DateTime            @default(now())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider        Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([riderId, createdAt])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  unitPrice      Decimal @default(0) @db.Decimal(10,2)
  totalPrice Decimal @default(0) @db.Decimal(10,2)
  orderId    Int
  menuItemId Int
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id Int @id @default(autoincrement())
  orderId Int @unique
  order Order @relation(fields: [orderId], references: [id])
  provider String @default("PAYSTACK")
  reference String @unique
  amount Decimal @db.Decimal(10,2)
  currency String @default("NGN")
  status PaymentStatus @default(PENDING)
  paidAt DateTime?
  refundedAt DateTime?
  refundReference String?
  gatewayResponse Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payout {
  id              Int          @id @default(autoincrement())
  orderId         Int
  order           Order        @relation(fields: [orderId], references: [id])
  type            PayoutType
  // Who is owed for a RIDER payout. Stored directly so the rider's history and
  // balance survive the delivery row being deleted on reassignment.
  riderId         Int?
  rider           Rider?       @relation(fields: [riderId], references: [id], onDelete: SetNull)
  attempt         Int          @default(1)
  amount          Decimal      @db.Decimal(10,2)
  recipientCode   String?
  reference       String       @unique
  status          PayoutStatus @default(PENDING)
  supersededBy    Int?
  gatewayResponse Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderId])
  @@index([type, status])
  @@index([riderId, status])
}

model RestaurantReview {
  id           Int        @id @default(autoincrement())
  rating       Int
  comment      String?
  authorId     Int
  restaurantId Int
  author       User       @relation(fields: [authorId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([authorId, restaurantId])
  @@index([restaurantId, createdAt])
}

model RiderReview {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  authorId  Int
  riderId   Int
  author    User     @relation(fields: [authorId], references: [id])
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, riderId])
  @@index([riderId, createdAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())

  @@index([userId])
}