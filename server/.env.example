# ── Server ──
PORT=5000

# ── Database (Supabase Postgres) ──
# Pooled connection (pgbouncer, port 6543) — used by Prisma Client at runtime.
# `connection_limit` caps Prisma's pool so a burst of requests can't exhaust
# Supabase's free-tier connection limit.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection (port 5432) — used by `prisma migrate deploy`.
# Migrations must NOT run through the pgbouncer pool, hence the separate URL.
# `sslmode=require` is required (Supabase pooler only accepts SSL); `connect_timeout=30`
# avoids Prisma's short default timeout from dropping the pooler handshake.
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# ── Auth ──
# Any long, random string used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# ── Payments (Paystack) ──
# Paystack *secret* key (server-side only, starts with sk_). Never expose in the client.
PAYSTACK_SECRET_KEY="your-paystack-secret-key"

# ── Refunds ──
# Minutes after payment that a customer can cancel and still get a full refund.
# After this window the customer can still cancel, but no refund is issued.
REFUND_WINDOW_MINUTES=3

# ── Payouts (Transfers) ──
# "true" fires real Paystack Transfers the moment an order is delivered (requires
# a *Registered* Business Paystack account). Keep "false" (default) to record
# payouts as owed and settle restaurants/riders manually from the admin dashboard.
AUTO_PAYOUTS=false

# ── Admin ──
# Invite code required to register an ADMIN account.
ADMIN_INVITE_CODE="your-admin-invite-code"

# ── Email (Resend) ──
# API key from https://resend.com (starts with re_).
RESEND_API_KEY="your-resend-api-key"
# "From" address for transactional emails. Must be verified in your Resend account.
RESEND_FROM="ChowZilla <onboarding@resend.dev>"

# ── CORS ──
# Origin the frontend runs on — allowed to call this API.
CLIENT_URL="http://localhost:5173"

# ── Web Push (VAPID) ──
# Generate with: npx web-push generate-vapid-keys --json
# The public key is exposed to the browser (via GET /push/public-key); the
# private key is a secret and must stay server-side only.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# ── Native Push (FCM / Firebase) ──
# The Firebase service-account private key (Firebase console → Project settings →
# Service accounts → Generate new private key). It's a SECRET — never commit it.
#
# Two ways to provide it, depending on where the server runs:
#   1. FIREBASE_SERVICE_ACCOUNT (preferred for hosts like Render) — the full
#      JSON contents as one env var (minified to a single line).
#   2. FIREBASE_SERVICE_ACCOUNT_PATH (local dev) — path to the gitignored
#      firebase-service-account.json file on disk.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
