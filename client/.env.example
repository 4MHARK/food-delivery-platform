# Copy to `.env` for local dev. For production, define the SAME keys in
# `.env.production` or your host's env vars (VITE_API_URL = deployed backend URL).

# ── API ──
# Base URL of the ChowZilla backend.
VITE_API_URL=http://localhost:5000

# ── Payments (Paystack) ──
# Paystack *public* key (safe to expose in the browser; starts with pk_).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Error tracking (Sentry) ──
# DSN of the *browser* Sentry project. Public by design — it ships inside the JS
# bundle, so it is readable by anyone. It is not an auth token.
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0000000.ingest.us.sentry.io/0000000000000000

# ── Source maps (build-time only) ──
# Read by vite.config.js, NOT by app code. These deliberately have no VITE_
# prefix: a prefixed token would be inlined into the browser bundle and handed
# to every visitor.
#
# SENTRY_AUTH_TOKEN is a real secret — create it at
# https://sentry.io/settings/auth-tokens/ with the `project:releases` scope.
# Slugs (not the numeric IDs) are in your Sentry URLs:
#   org     → sentry.io/organizations/<SENTRY_ORG>/...
#   project → sentry.io/settings/projects/<SENTRY_PROJECT>/
# Leaving SENTRY_AUTH_TOKEN empty simply skips the upload step.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-browser-project-slug
SENTRY_AUTH_TOKEN=
